# ── Voice (required for talking to the canvas) ─────────────────────────────
# https://www.assemblyai.com/dashboard/api-keys
# Server-only. The browser only ever receives short-lived, single-use tokens.
ASSEMBLYAI_API_KEY=

# Optional: cap each voice session (seconds, 60–10800). Default 1800.
# VOICE_MAX_SESSION_SECONDS=1800
# Optional: token mints per IP per minute (in-memory, per instance). Default 20.
# VOICE_TOKENS_PER_MINUTE=20

# ── Storage (optional) ─────────────────────────────────────────────────────
# Without these, diagrams and version history live in the browser (localStorage).
# With them, they're stored in Upstash Redis (Vercel Marketplace → Upstash sets
# KV_REST_API_URL / KV_REST_API_TOKEN, which are also accepted).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Site ───────────────────────────────────────────────────────────────────
# Used for metadata and the pitch deck's closing slide.
# NEXT_PUBLIC_SITE_URL=https://talkgraph.vercel.app
